      {
        "error": "Collisions on modern switched network",
        "solution": "Ensure full-duplex is configured; collisions shouldn't occur with switches"
      }
    ],
    "questions": [
      {
        "question": "What replaced CSMA/CD in modern networks?",
        "solution": "Full-duplex switched Ethernet"
      },
      {
        "question": "How many collision domains does a hub have?",
        "solution": "1 (all ports share one collision domain)"
      }
    ],
    "prerequisites": "Basic computer literacy, understanding of IP addressing",
    "steps": [
      {
        "stepId": "183-S-01",
        "title": "Configure Ethernet Interface Settings",
        "instruction": "Configure Ethernet Interface Settings for Ethernet",
        "commands": [
          "enable",
          "configure terminal",
          "interface GigabitEthernet0/0",
          "speed 1000",
          "duplex full",
          "no shutdown",
          "exit",
          "end"
        ],
        "expectedOutput": "Ethernet configured at 1Gbps full duplex",
        "verification": {
          "type": "command",
          "expected": [
            "show interfaces GigabitEthernet0/0"
          ]
        },
        "commonErrors": [
          {
            "error": "Speed/duplex mismatch",
            "solution": "Match settings on both ends"
          }
        ],
