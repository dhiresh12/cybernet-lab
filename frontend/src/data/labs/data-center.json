    "errors": [
      {
        "error": "ARP flux between leaves",
        "solution": "Ensure consistent gateway MAC and ARP suppression."
      }
    ],
    "questions": [
      {
        "question": "Anycast gateway benefit?",
        "solution": "Local leaf always first hop; reduces latency and uplink load."
      }
    ],
    "steps": [
      {
        "stepId": "135-S-01",
        "title": "Configure Spine-Leaf Architecture",
        "instruction": "Configure Spine-Leaf Architecture for Data Center",
        "commands": [
          "enable",
          "configure terminal",
          "interface GigabitEthernet0/1",
          "ip address 10.0.0.1 255.255.255.0",
          "no shutdown",
          "exit",
          "router bgp 65001",
          "neighbor 10.0.0.2 remote-as 65002",
          "exit",
          "end"
        ],
        "expectedOutput": "Spine-leaf architecture configured",
        "verification": {
          "type": "command",
          "expected": [
            "show ip interface brief"
          ]
        },
