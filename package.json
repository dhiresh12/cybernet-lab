{
  "name": "cybernet-lab",
  "version": "4.0.0",
  "description": "High-fidelity autonomous networking virtual laboratory",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "nodemon backend/server.js",
    "frontend": "vite frontend",
    "build": "node build.mjs",
    "start": "node backend/server.js",
    "sim": "node simulation/engine.js",
    "test": "jest",
    "lint": "eslint frontend/src backend --ext .js,.jsx",
    "package": "node deploy/package.js",
    "docker:build": "docker build -t cybernet-lab/backend -f backend/Dockerfile .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "k8s:apply": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.12",
    "@grpc/proto-loader": "^0.7.13",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.6.10",
    "three": "^0.150.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "yaml": "^2.3.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-jest": "^30.5.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "vite": "^5.1.0"
  }
}
