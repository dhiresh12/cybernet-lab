# .env.example - CyberNet Lab Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# --- Core ---
NODE_ENV=development
PORT=3000
GRPC_PORT=50051

# --- Database ---
DATABASE_URL=postgresql://cybernet:cybernet_pass@localhost:5432/cybernet_lab
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybernet_lab
DB_USER=cybernet
DB_PASSWORD=cybernet_pass

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth & Security ---
JWT_SECRET=change_me_to_a_64_char_random_string_for_production_use

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Logging ---
LOG_LEVEL=info
LOG_FILE_PATH=./logs/cybernet-lab.log

# --- Frontend (Vite injects these at build time) ---
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
